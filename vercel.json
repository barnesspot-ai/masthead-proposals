{
  "rewrites": [
    {
      "source": "/proposals/:slug/proposal-data.js",
      "destination": "/proposals/:slug/proposal-data.js"
    },
    {
      "source": "/proposal/:slug",
      "destination": "/proposal.html"
    }
  ],
  "headers": [
    {
      "source": "/proposals/(.*)",
      "headers": [
        { "key": "Content-Type", "value": "application/javascript" },
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    }
  ]
}
